<!DOCTYPE html>
<html>
<head>
  <%- include ("../partials/header.ejs") %>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: #f3f6fb;
      color: #111827;
      padding: 0;
    }

    .top-bar {
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      min-height: 64px;
      background: #1d4ed8;
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      z-index: 1000;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      gap: 12px;
      flex-wrap: wrap;
    }

    .top-status {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }

    .status-chip,
    .status-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.15);
      color: #f8fafc;
      font-weight: 600;
      backdrop-filter: blur(6px);
    }

    .phase-bar {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(6px);
      flex-wrap: wrap;
    }

    .phase-chip {
      border: none;
      border-radius: 999px;
      padding: 6px 10px;
      background: transparent;
      color: #dbeafe;
      font-size: 0.8rem;
      font-weight: 700;
      line-height: 1;
    }

    .phase-chip:hover:not(:disabled) {
      background: rgba(255, 255, 255, 0.2);
      color: #ffffff;
      cursor: pointer;
    }

    .phase-chip.phase-chip-active {
      background: #ffffff;
      color: #1d4ed8;
    }

    .phase-chip:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .status-toggle input {
      margin: 0;
    }

    .bottom-bar {
      position: sticky;
      bottom: 0;
      left: 0;
      right: 0;
      min-height: 76px;
      background: #111827;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 12px 16px;
      z-index: 1000;
      font-size: 0.95rem;
      gap: 12px;
      flex-wrap: wrap;
    }

    .bottom-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .layout {
      display: grid;
      grid-template-columns: 270px minmax(0, 1fr) 320px;
      gap: 20px;
      padding: 20px;
    }

    .panel {
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      padding: 16px;
    }

    .panel h3, .panel h4 {
      margin-top: 0;
    }

    .center-column {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .board-panel {
      background: #87ceeb;
      min-height: 540px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 20px;
      gap: 12px;
      position: relative;
    }

    .winner-overlay {
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.38);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10;
      pointer-events: none;
    }

    .winner-overlay-visible {
      display: flex;
    }

    .winner-banner {
      background: rgba(255, 255, 255, 0.9);
      color: #111827;
      padding: 10px 16px;
      border-radius: 10px;
      font-size: 1.05rem;
      font-weight: 800;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
    }

    .board-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 12px;
    }

    .board-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .bank-panel {
      width: 100%;
      background: white;
      border-radius: 12px;
      padding: 14px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .bank-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 10px;
    }

    .board-map-wrapper {
      position: relative;
      width: min(100%, 560px);
      margin-top: 8px;
      padding-top: 14px;
      padding-bottom: 18px;
    }

    .board-suggestion-layer {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 3;
    }

    .placement-suggestion {
      position: absolute;
      transform: translate(-50%, -50%);
      background: rgba(15, 23, 42, 0.2);
    }

    .placement-suggestion-point {
      width: 10px;
      height: 10px;
      border-radius: 999px;
    }

    .placement-suggestion-road {
      width: 26px;
      height: 6px;
      border-radius: 999px;
    }

    .board-map {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .board-hex {
      width: 102px;
      height: 112px;
      position: absolute;
      transform: translate(-50%, -50%);
      clip-path: polygon(50% 2.5%, 95% 25%, 95% 75%, 50% 97.5%, 5% 75%, 5% 25%);
      border: 2px solid rgba(15, 23, 42, 0.3);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #0f172a;
      position: relative;
    }

    .board-hex-name {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.2px;
      text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
    }

    .board-hex-pip {
      min-width: 28px;
      height: 28px;
      padding: 0 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.86);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 800;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    }

    .board-hex-desert {
      background: #f2d9a6 !important;
      border-color: rgba(146, 64, 14, 0.42);
    }

    .board-hex-desert .board-hex-pip {
      visibility: hidden;
    }

    .board-slot-layer {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 4;
    }

    .board-slot {
      position: absolute;
      pointer-events: auto;
      border: none;
      background: transparent;
      color: #0f172a;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      line-height: 1;
      padding: 0;
    }

    .board-slot-target {
      background: rgba(34, 197, 94, 0.38);
      box-shadow: none;
      cursor: pointer;
    }

    .board-slot-road {
      width: 50px;
      height: 14px;
      border-radius: 999px;
    }

    .board-slot-point {
      width: 26px;
      height: 26px;
      border-radius: 999px;
      font-size: 0.72rem;
    }

    .resource-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 10px;
    }

    .resource-item {
      display: flex;
      justify-content: space-between;
      padding: 8px 10px;
      background: #f8fafc;
      border-radius: 8px;
      border: none;
      width: 100%;
      text-align: left;
      align-items: center;
    }

    .resource-item:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .resource-item:hover:not(:disabled) {
      background: #eef2ff;
      cursor: pointer;
    }

    .hand-group {
      margin-top: 12px;
    }

    .hand-group-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: #374151;
      margin-bottom: 8px;
    }

    .hand-chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .hand-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 5px 9px;
      border-radius: 999px;
      background: #eef2ff;
      color: #1e40af;
      font-size: 0.78rem;
      font-weight: 700;
      border: none;
      line-height: 1;
    }

    .hand-chip-action:hover:not(:disabled) {
      background: #dbeafe;
      cursor: pointer;
    }

    .hand-chip-selected {
      background: #1d4ed8;
      color: #ffffff;
      box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.35);
    }

    .hand-chip:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .dev-card-section {
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid #e5e7eb;
    }

    .dev-card-section-title {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .player-secondary-metrics {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 4px;
    }

    .mini-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 3px 6px;
      border-radius: 999px;
      background: #e0f2fe;
      color: #075985;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .dev-card-button {
      width: 100%;
      text-align: left;
      border: none;
    }

    .special-marker {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      margin-left: 4px;
      border-radius: 999px;
      background: #dc2626;
      color: white;
      font-size: 0.72rem;
      font-weight: 700;
      line-height: 1;
    }

    .event-log-box {
      max-height: 220px;
      overflow-y: auto;
      padding-right: 6px;
    }

    .event-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .event-item {
      font-size: 0.9rem;
      padding: 8px 10px;
      background: #f8fafc;
      border-radius: 8px;
    }

    .player-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 10px;
    }

    .player-entry {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 8px 10px;
      background: #f8fafc;
      border-radius: 8px;
      align-items: center;
    }

    .player-metrics {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .badge-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 28px;
      padding: 4px 8px;
      border-radius: 999px;
      background: #dbeafe;
      color: #1d4ed8;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .badge-pill-green {
      background: #dcfce7;
      color: #166534;
    }

    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .board-panel {
        min-height: 360px;
      }
    }

    @media (max-width: 640px) {
      .top-bar {
        padding: 12px 14px;
      }

      .top-status {
        width: 100%;
        justify-content: space-between;
      }

      .bottom-bar {
        padding: 12px 14px;
      }

      .bottom-controls {
        width: 100%;
      }

      .layout {
        padding: 14px;
        gap: 14px;
      }

      .board-map-wrapper {
        width: 100%;
      }

      .board-hex {
        width: 82px;
        height: 90px;
      }

      .board-hex-name {
        font-size: 0.62rem;
      }

      .board-hex-pip {
        min-width: 22px;
        height: 22px;
        font-size: 0.72rem;
      }

      .bank-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <div><strong>CatanLive</strong></div>
    <div class="top-status">
      <div id="playerNameBar" class="status-chip">Your name: Waiting for player name...</div>
      <div id="phaseBar" class="phase-bar" role="group" aria-label="Game phase">
        <button class="phase-chip" type="button" data-phase="boardSetup">Board Setup</button>
        <button class="phase-chip" type="button" data-phase="initialPlacement">Initial Placement</button>
        <button class="phase-chip" type="button" data-phase="play">Play</button>
        <button class="phase-chip" type="button" data-phase="endGame">End Of Game</button>
      </div>
      <button id="undoButton" class="btn btn-outline-light btn-sm" disabled>Undo</button>
      <button id="flipButton" class="btn btn-light btn-sm">Flip the board</button>
    </div>
  </div>

  <div class="layout">
    <aside class="panel">
      <h3>Hand</h3>
      <div class="hand-group">
        <div class="hand-group-title">Pieces</div>
        <div id="handPieces" class="hand-chip-list"></div>
      </div>
      <div class="hand-group">
        <div class="hand-group-title">Resources</div>
        <div id="playerResources" class="hand-chip-list"></div>
      </div>
      <div class="dev-card-section">
        <div class="dev-card-section-title">Hidden Dev Cards</div>
        <div id="hiddenDevelopmentCards" class="hand-chip-list"></div>
      </div>
    </aside>

    <main class="center-column">
      <div class="panel board-panel">
        <div class="board-header">
          <h3>Board</h3>
          <div class="board-actions">
            <button id="randomTileButton" class="btn btn-info" disabled>Random Tiles</button>
            <button id="randomPipButton" class="btn btn-warning" disabled>Random Pips</button>
          </div>
        </div>
        <div id="rollDisplay" class="mb-2"><strong>Last roll:</strong> None</div>
        <div class="board-map-wrapper">
          <div id="boardHexMap" class="board-map"></div>
          <div id="boardSuggestionLayer" class="board-suggestion-layer"></div>
          <div id="boardRoadSlots" class="board-slot-layer"></div>
          <div id="boardPointSlots" class="board-slot-layer"></div>
        </div>
        <div id="winnerOverlay" class="winner-overlay">
          <div id="winnerBanner" class="winner-banner"></div>
        </div>
      </div>
      <div class="panel bank-panel">
        <h4>Bank</h4>
        <div id="bankResources" class="bank-grid"></div>
      </div>
    </main>

    <aside class="panel">
      <h3>Log</h3>
      <div class="event-log-box">
        <ul id="eventList" class="event-list"></ul>
      </div>
      <h4 class="mt-3">Players</h4>
      <div id="playerList" class="player-list"></div>
    </aside>
  </div>

  <div class="bottom-bar">
    <div class="bottom-controls">
      <button id="rollButton" class="btn btn-success" disabled>Roll Dice</button>
      <button id="winButton" class="btn btn-light" disabled>I won!</button>
      <button id="longestRoadButton" class="btn btn-outline-light" disabled>Take Longest Road</button>
      <button id="largestArmyButton" class="btn btn-outline-light" disabled>Take Largest Army</button>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
  <script>
    const initialState = <%- JSON.stringify(initialState) %>
    const STORAGE_KEY = 'catanlive_player'
    let currentPlayerId = null
    let currentPlayerName = ''
    let state = initialState
    let actionInFlight = false
    let selectedPlacementPiece = null

    const playerNameBar = document.getElementById('playerNameBar')
    const handPieces = document.getElementById('handPieces')
    const playerResources = document.getElementById('playerResources')
    const hiddenDevelopmentCards = document.getElementById('hiddenDevelopmentCards')
    const bankResources = document.getElementById('bankResources')
    const playerList = document.getElementById('playerList')
    const eventList = document.getElementById('eventList')
    const rollDisplay = document.getElementById('rollDisplay')
    const phaseBar = document.getElementById('phaseBar')
    const rollButton = document.getElementById('rollButton')
    const randomTileButton = document.getElementById('randomTileButton')
    const randomPipButton = document.getElementById('randomPipButton')
    const winButton = document.getElementById('winButton')
    const longestRoadButton = document.getElementById('longestRoadButton')
    const largestArmyButton = document.getElementById('largestArmyButton')
    const undoButton = document.getElementById('undoButton')
    const flipButton = document.getElementById('flipButton')
    const boardHexMap = document.getElementById('boardHexMap')
    const boardSuggestionLayer = document.getElementById('boardSuggestionLayer')
    const boardRoadSlots = document.getElementById('boardRoadSlots')
    const boardPointSlots = document.getElementById('boardPointSlots')
    const winnerOverlay = document.getElementById('winnerOverlay')
    const winnerBanner = document.getElementById('winnerBanner')

    const resourceColors = {
      Sheep: '#86efac',
      Wheat: '#facc15',
      Ore: '#9ca3af',
      Wood: '#15803d',
      Brick: '#b45309',
      Desert: '#f2d9a6'
    }

    function renderBoardHexMap() {
      const boardHexes = Array.isArray(state.board?.hexes) ? state.board.hexes : []
      const model = buildBoardRenderModel()

      if (!model) {
        return
      }

      boardHexMap.innerHTML = ''

      ;[boardHexMap, boardSuggestionLayer, boardRoadSlots, boardPointSlots].forEach((layer) => {
        layer.style.width = `${model.width}px`
        layer.style.height = `${model.height}px`
      })

      boardHexes.forEach((hex) => {
        const tile = document.createElement('div')
        tile.className = 'board-hex'

        const position = model.hexMap.get(hex.id)
        if (!position) {
          return
        }

        tile.style.left = `${position.x}px`
        tile.style.top = `${position.y}px`

        const resourceName = hex.resource || 'Unknown'
        if (resourceName === 'Desert') {
          tile.classList.add('board-hex-desert')
        }

        tile.style.background = resourceColors[resourceName] || '#f8fafc'
        const pipText = hex.pip === null || hex.pip === undefined ? '-' : String(hex.pip)
        tile.innerHTML = `<span class="board-hex-name">${resourceName}</span><span class="board-hex-pip">${pipText}</span>`
        boardHexMap.appendChild(tile)
      })
    }

    function buildBoardRenderModel() {
      const board = state.board || { hexes: [], points: [], roads: [] }
      const hexes = Array.isArray(board.hexes) ? board.hexes : []
      const points = Array.isArray(board.points) ? board.points : []
      const roads = Array.isArray(board.roads) ? board.roads : []

      const hexSize = 40
      const pointyX = Math.sqrt(3) * hexSize
      const pointyY = 1.5 * hexSize

      const hexCenters = hexes.map((hex) => {
        const x = pointyX * ((hex.q || 0) + ((hex.r || 0) / 2))
        const y = pointyY * (hex.r || 0)
        return {
          id: hex.id,
          x,
          y
        }
      })

      const pointPositionsRaw = points.map((point) => {
        const x = pointyX * ((point.x2 || 0) / 2 + (point.z2 || 0) / 4)
        const y = pointyY * ((point.z2 || 0) / 2)
        return {
          id: point.id,
          x,
          y
        }
      })

      const allX = [...hexCenters.map((entry) => entry.x), ...pointPositionsRaw.map((entry) => entry.x)]
      const allY = [...hexCenters.map((entry) => entry.y), ...pointPositionsRaw.map((entry) => entry.y)]

      const minX = Math.min(...allX)
      const maxX = Math.max(...allX)
      const minY = Math.min(...allY)
      const maxY = Math.max(...allY)
      const padding = 46
      const width = Math.ceil((maxX - minX) + (padding * 2))
      const height = Math.ceil((maxY - minY) + (padding * 2))

      const normalizeX = (x) => x - minX + padding
      const normalizeY = (y) => y - minY + padding

      const hexMap = new Map()
      hexCenters.forEach((entry) => {
        hexMap.set(entry.id, {
          x: normalizeX(entry.x),
          y: normalizeY(entry.y)
        })
      })

      const pointMap = new Map()
      pointPositionsRaw.forEach((entry) => {
        pointMap.set(entry.id, {
          x: normalizeX(entry.x),
          y: normalizeY(entry.y)
        })
      })

      const roadMap = new Map()
      roads.forEach((road) => {
        const first = pointMap.get(road.pointA)
        const second = pointMap.get(road.pointB)
        if (!first || !second) {
          return
        }

        const x = (first.x + second.x) / 2
        const y = (first.y + second.y) / 2
        const angle = Math.atan2(second.y - first.y, second.x - first.x) * (180 / Math.PI)

        roadMap.set(road.id, { x, y, angle })
      })

      return {
        width,
        height,
        hexMap,
        pointMap,
        roadMap
      }
    }

    function renderPlacementSuggestions() {
      boardSuggestionLayer.innerHTML = ''
      const model = buildBoardRenderModel()
      if (!model) {
        return
      }

      const board = state.board || { points: [], roads: [] }
      const points = Array.isArray(board.points) ? board.points : []
      const roads = Array.isArray(board.roads) ? board.roads : []

      points.forEach((point) => {
        const position = model.pointMap.get(point.id)
        if (!position) {
          return
        }

        const marker = document.createElement('span')
        marker.className = 'placement-suggestion placement-suggestion-point'
        marker.style.left = `${position.x}px`
        marker.style.top = `${position.y}px`
        boardSuggestionLayer.appendChild(marker)
      })

      roads.forEach((road) => {
        const position = model.roadMap.get(road.id)
        if (!position) {
          return
        }

        const marker = document.createElement('span')
        marker.className = 'placement-suggestion placement-suggestion-road'
        marker.style.left = `${position.x}px`
        marker.style.top = `${position.y}px`
        marker.style.transform = `translate(-50%, -50%) rotate(${position.angle}deg)`
        boardSuggestionLayer.appendChild(marker)
      })
    }

    function getCurrentPlayer() {
      return state.players.find((player) => player.id === currentPlayerId) || null
    }

    function clearPlayerIdentity() {
      localStorage.removeItem(STORAGE_KEY)
      currentPlayerId = null
      currentPlayerName = ''
    }

    function getDevelopmentCardTotal(player) {
      return Object.values(player?.developmentCards || {}).reduce((total, value) => total + Number(value || 0), 0)
    }

    function getPhaseLabel(phase) {
      if (phase === 'boardSetup') {
        return 'Board Setup'
      }
      if (phase === 'initialPlacement') {
        return 'Initial Placement'
      }
      if (phase === 'play') {
        return 'Play'
      }
      if (phase === 'endGame') {
        return 'End Of Game'
      }
      return 'Unknown'
    }

    async function runAction(handler) {
      if (actionInFlight) {
        return null
      }

      actionInFlight = true
      render()

      try {
        return await handler()
      } finally {
        actionInFlight = false
        render()
      }
    }

    function getPieceCount(player, pieceType) {
      if (!player) {
        return 0
      }

      if (pieceType === 'road') {
        return Number(player.roads || 0)
      }

      if (pieceType === 'settlement') {
        return Number(player.settlements || 0)
      }

      if (pieceType === 'city') {
        return Number(player.cities || 0)
      }

      return 0
    }

    function toggleSelectedPiece(pieceType) {
      if (selectedPlacementPiece === pieceType) {
        selectedPlacementPiece = null
      } else {
        selectedPlacementPiece = pieceType
      }
      render()
    }

    async function handlePlacePiece(pieceType, targetType, targetId) {
      await runAction(async () => {
        const data = await requestJson('/place-piece', {
          playerId: currentPlayerId,
          playerName: currentPlayerName,
          pieceType,
          targetType,
          targetId
        })

        if (data) {
          state = data.state
          const currentPlayer = state.players.find((player) => player.id === currentPlayerId)
          if (!currentPlayer || getPieceCount(currentPlayer, pieceType) <= 0) {
            selectedPlacementPiece = null
          }
        }
      })
    }

    function renderBoardPlacementSlots(currentPlayer) {
      const board = state.board || { roads: [], points: [] }
      const currentPlayerColor = currentPlayer?.color || '#1f2937'
      const model = buildBoardRenderModel()

      boardRoadSlots.innerHTML = ''
      board.points = Array.isArray(board.points) ? board.points : []

      if (!model) {
        return
      }

      ;(Array.isArray(board.roads) ? board.roads : []).forEach((slot) => {
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'board-slot board-slot-road'
        const roadPosition = model.roadMap.get(slot.id)
        if (!roadPosition) {
          return
        }
        button.style.left = `${roadPosition.x}px`
        button.style.top = `${roadPosition.y}px`
        button.style.transform = `translate(-50%, -50%) rotate(${roadPosition.angle}deg)`
        const isOwned = Boolean(slot.ownerId)
        const canPlaceRoad = Boolean(currentPlayer) && !state.winner && selectedPlacementPiece === 'road' && !actionInFlight && !isOwned && getPieceCount(currentPlayer, 'road') > 0

        if (canPlaceRoad) {
          button.classList.add('board-slot-target')
        }

        if (isOwned) {
          button.style.background = slot.ownerColor || '#9ca3af'
        }

        button.title = isOwned ? 'Road occupied' : canPlaceRoad ? 'Place road here' : 'Empty road slot'
        button.disabled = !canPlaceRoad
        button.addEventListener('click', () => {
          if (!canPlaceRoad) {
            return
          }
          handlePlacePiece('road', 'road', slot.id)
        })
        boardRoadSlots.appendChild(button)
      })

      boardPointSlots.innerHTML = ''
      board.points.forEach((slot) => {
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'board-slot board-slot-point'
        const pointPosition = model.pointMap.get(slot.id)
        if (!pointPosition) {
          return
        }
        button.style.left = `${pointPosition.x}px`
        button.style.top = `${pointPosition.y}px`
        button.style.transform = 'translate(-50%, -50%)'

        const isFree = !slot.ownerId
        const isOwnSettlement = slot.ownerId === currentPlayer?.id && slot.pieceType === 'settlement'
        const canPlaceSettlement = Boolean(currentPlayer) && !state.winner && selectedPlacementPiece === 'settlement' && !actionInFlight && isFree && getPieceCount(currentPlayer, 'settlement') > 0
        const canUpgradeCity = Boolean(currentPlayer) && !state.winner && selectedPlacementPiece === 'city' && !actionInFlight && isOwnSettlement && getPieceCount(currentPlayer, 'city') > 0
        const canUsePoint = canPlaceSettlement || canUpgradeCity

        if (canUsePoint) {
          button.classList.add('board-slot-target')
        }

        if (!isFree) {
          button.style.background = slot.ownerColor || '#9ca3af'
          button.textContent = slot.pieceType === 'city' ? '🏰' : '🏠'
          button.style.color = '#ffffff'
        } else {
          button.textContent = ''
          button.style.background = 'transparent'
          button.style.color = canUsePoint ? currentPlayerColor : '#334155'
        }

        if (slot.pieceType === 'city') {
          button.title = 'City occupied'
        } else if (slot.pieceType === 'settlement') {
          button.title = canUpgradeCity ? 'Upgrade this settlement to a city' : 'Settlement occupied'
        } else {
          button.title = canPlaceSettlement ? 'Place settlement here' : 'Empty point slot'
        }

        button.disabled = !canUsePoint
        button.addEventListener('click', () => {
          if (!canUsePoint) {
            return
          }

          if (canPlaceSettlement) {
            handlePlacePiece('settlement', 'point', slot.id)
            return
          }

          if (canUpgradeCity) {
            handlePlacePiece('city', 'point', slot.id)
          }
        })
        boardPointSlots.appendChild(button)
      })
    }

    function render() {
      const currentPlayer = getCurrentPlayer()
      const bank = state.bank || { resources: {}, developmentCards: {} }
      const playerResourcesForHand = currentPlayer?.resources || {}

      renderBoardHexMap()
      renderPlacementSuggestions()

      if (!currentPlayer) {
        selectedPlacementPiece = null
      } else if (selectedPlacementPiece && getPieceCount(currentPlayer, selectedPlacementPiece) <= 0) {
        selectedPlacementPiece = null
      }

      playerNameBar.textContent = currentPlayer
        ? `Your name: ${currentPlayerName}`
        : 'Your name: Waiting for player name...'

      handPieces.innerHTML = ''
      ;[
        { key: 'road', icon: '🛣️', label: 'Roads' },
        { key: 'settlement', icon: '🏠', label: 'Settlements' },
        { key: 'city', icon: '🏰', label: 'Cities' }
      ].forEach((entry) => {
        const count = getPieceCount(currentPlayer, entry.key)
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'hand-chip hand-chip-action'
        if (selectedPlacementPiece === entry.key) {
          button.classList.add('hand-chip-selected')
        }
        button.title = `Select ${entry.label}`
        button.textContent = `${entry.icon} ×${count}`
        button.disabled = !currentPlayer || count <= 0 || actionInFlight || Boolean(state.winner)
        button.addEventListener('click', () => {
          if (!currentPlayer || count <= 0) {
            return
          }
          toggleSelectedPiece(entry.key)
        })
        handPieces.appendChild(button)
      })

      renderBoardPlacementSlots(currentPlayer)

      playerResources.innerHTML = ''
      ;[
        { key: 'Wheat', icon: '🌾' },
        { key: 'Sheep', icon: '🐑' },
        { key: 'Ore', icon: '⛰️' },
        { key: 'Wood', icon: '🌲' },
        { key: 'Brick', icon: '🧱' }
      ].forEach((resource) => {
        const count = currentPlayer ? (playerResourcesForHand[resource.key] || 0) : 0
        if (!currentPlayer || count <= 0) {
          return
        }

        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'hand-chip hand-chip-action'
        button.textContent = `${resource.icon} ${resource.key} ×${count}`
        button.disabled = !currentPlayer || count <= 0 || actionInFlight
        button.title = count > 0 ? `Return 1 ${resource.key} to the bank` : `No ${resource.key}`
        button.addEventListener('click', () => {
          if (!currentPlayer) {
            return
          }
          handleReturnResource(resource.key)
        })
        playerResources.appendChild(button)
      })

      hiddenDevelopmentCards.innerHTML = ''
      ;[
        { key: 'knights', label: 'Knight', icon: '⚔️', playable: true },
        { key: 'victoryPoints', label: 'Victory Point', icon: '⭐', playable: false },
        { key: 'monopoly', label: 'Monopoly', icon: '⛓️', playable: true },
        { key: 'roadBuilding', label: 'Road Building', icon: '🛣️', playable: true },
        { key: 'yearOfPlenty', label: 'Year of Plenty', icon: '🌾', playable: true }
      ].forEach((entry) => {
        const count = currentPlayer ? (currentPlayer.developmentCards?.[entry.key] || 0) : 0
        if (!currentPlayer || count <= 0) {
          return
        }

        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'hand-chip hand-chip-action'
        button.textContent = `${entry.icon} ${entry.label} ×${count}`
        button.disabled = !currentPlayer || count <= 0 || actionInFlight || state.gamePhase !== 'play' || Boolean(state.winner) || !entry.playable
        button.title = entry.playable ? `Play ${entry.label}` : `${entry.label} remains hidden until game end`
        button.addEventListener('click', () => {
          if (!currentPlayer || !entry.playable) {
            return
          }
          handlePlayDevelopmentCard(entry.key)
        })
        hiddenDevelopmentCards.appendChild(button)
      })

      bankResources.innerHTML = ''
      ;['Wheat', 'Sheep', 'Ore', 'Wood', 'Brick'].forEach((resource) => {
        const count = bank.resources?.[resource] || 0
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'resource-item'
        button.innerHTML = `<span style="color:${resourceColors[resource]}; font-weight:700;">${resource}</span><strong>${count}</strong>`
        button.disabled = !currentPlayer || count <= 0 || actionInFlight
        button.title = count > 0 ? `Take 1 ${resource} from the bank` : `No ${resource}`
        button.addEventListener('click', () => {
          if (!currentPlayer) {
            return
          }
          handleTakeResource(resource)
        })
        bankResources.appendChild(button)
      })

      const devButton = document.createElement('button')
      devButton.type = 'button'
      devButton.className = 'resource-item'
      const devCount = Object.values(bank.developmentCards || {}).reduce((sum, value) => sum + Number(value || 0), 0)
      devButton.innerHTML = '<span style="font-weight:700;">Dev. Card</span><strong>' + devCount + '</strong>'
      devButton.disabled = !currentPlayer || devCount <= 0 || state.gamePhase !== 'play' || Boolean(state.winner) || actionInFlight
      devButton.title = state.gamePhase !== 'play' ? 'Development cards are only available during the play phase' : 'Take a development card from the bank'
      devButton.addEventListener('click', () => {
        if (!currentPlayer) {
          return
        }
        handleTakeDevelopmentCard()
      })
      bankResources.appendChild(devButton)

      playerList.innerHTML = ''
      for (let index = 0; index < 4; index += 1) {
        const player = state.players[index]
        const slot = player || {
          name: `Player ${index + 1}`,
          color: '#6b7280',
          count: 0,
          rolls: 0,
          resources: {}
        }
        const item = document.createElement('div')
        item.className = 'player-entry'
        const resourceTotal = Object.values(slot.resources || {}).reduce((sum, value) => sum + Number(value || 0), 0)
        const devTotal = getDevelopmentCardTotal(slot)
        const specialMarks = []
        if (slot.id === state.longestRoadPlayerId) {
          specialMarks.push('<span class="special-marker" title="Longest Road">LR</span>')
        }
        if (slot.id === state.largestArmyPlayerId) {
          specialMarks.push('<span class="special-marker" title="Largest Army">LA</span>')
        }
        const playedBreakdown = [
          { key: 'knights', label: '⚔️' },
          { key: 'monopoly', label: '⛓️' },
          { key: 'roadBuilding', label: '🛣️' },
          { key: 'yearOfPlenty', label: '🌾' }
        ].flatMap((entry) => {
          const count = slot.playedDevelopmentCards?.[entry.key] || 0
          if (count <= 0) {
            return []
          }

          const label = count > 1 ? `${entry.label}×${count}` : entry.label
          return [`<span class="mini-pill" title="${entry.key} ×${count}">${label}</span>`]
        }).join('')
        item.innerHTML = `
          <div>
            <div style="color:${slot.color}; font-weight:700;">${slot.name}${specialMarks.length ? ` ${specialMarks.join('')}` : ''}</div>
            <div class="player-secondary-metrics">${playedBreakdown}</div>
          </div>
          <div class="player-metrics">
            <span class="badge-pill" title="Resource cards">${resourceTotal}</span>
            <span class="badge-pill badge-pill-green" title="Hidden dev cards">${devTotal}</span>
          </div>
        `
        playerList.appendChild(item)
      }

      eventList.innerHTML = ''
      ;(state.eventLog || []).slice().reverse().forEach((entry) => {
        const item = document.createElement('li')
        item.className = 'event-item'
        item.textContent = entry
        eventList.appendChild(item)
      })

      if (state.lastRoll !== null && state.lastRollBy) {
        rollDisplay.innerHTML = `<strong>Last roll:</strong> ${state.lastRoll} by ${state.lastRollBy}`
      } else {
        rollDisplay.innerHTML = '<strong>Last roll:</strong> None'
      }

      const phaseButtons = phaseBar.querySelectorAll('.phase-chip')
      phaseButtons.forEach((button) => {
        const isActive = button.dataset.phase === state.gamePhase
        button.classList.toggle('phase-chip-active', isActive)
      })

      if (state.winner) {
        winnerBanner.textContent = `${state.winner.name} won!`
        winnerOverlay.classList.add('winner-overlay-visible')
      } else {
        winnerBanner.textContent = ''
        winnerOverlay.classList.remove('winner-overlay-visible')
      }

      const controlsEnabled = Boolean(currentPlayer) && !actionInFlight
      const boardSetupEnabled = controlsEnabled && state.gamePhase === 'boardSetup' && !state.winner
      const gameOver = Boolean(state.winner)

      rollButton.disabled = !controlsEnabled
      randomTileButton.disabled = !boardSetupEnabled
      randomPipButton.disabled = !boardSetupEnabled
      winButton.disabled = !controlsEnabled || gameOver
      longestRoadButton.disabled = !controlsEnabled
      largestArmyButton.disabled = !controlsEnabled
      undoButton.disabled = !controlsEnabled

      phaseButtons.forEach((button) => {
        button.disabled = !controlsEnabled || gameOver
      })
    }

    function savePlayerIdentity(playerId, name) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ playerId, name }))
    }

    function loadPlayerIdentity() {
      const stored = localStorage.getItem(STORAGE_KEY)
      if (!stored) {
        return null
      }

      try {
        const parsed = JSON.parse(stored)
        if (parsed && parsed.playerId && parsed.name) {
          return parsed
        }
      } catch (error) {
        console.error(error)
      }

      return null
    }

    async function requestJson(url, body) {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })

      const data = await response.json().catch(() => ({}))
      if (!response.ok && data.error) {
        alert(data.error)
        return null
      }

      return data
    }

    async function joinPlayer(name) {
      const data = await requestJson('/join', { name })
      if (data && data.playerId) {
        currentPlayerId = data.playerId
        currentPlayerName = data.name
        state = data.state
        savePlayerIdentity(currentPlayerId, currentPlayerName)
        render()
      }
    }

    async function resumePlayer(playerId, name) {
      const data = await requestJson('/resume', { playerId, name })
      if (data && data.playerId) {
        currentPlayerId = data.playerId
        currentPlayerName = data.name
        state = data.state
        render()
        return true
      }

      return false
    }

    async function ensurePlayerSession(savedPlayer) {
      if (savedPlayer) {
        const resumed = await resumePlayer(savedPlayer.playerId, savedPlayer.name)
        if (resumed) {
          return true
        }
      }

      clearPlayerIdentity()

      const enteredName = window.prompt('Enter your player name', '')
      if (enteredName && enteredName.trim()) {
        await joinPlayer(enteredName.trim())
        return true
      }

      render()
      return false
    }

    async function handleTakeResource(resource) {
      await runAction(async () => {
        const data = await requestJson('/take-resource', { playerId: currentPlayerId, playerName: currentPlayerName, resource })
        if (data) {
          state = data.state
        }
      })
    }

    async function handleReturnResource(resource) {
      await runAction(async () => {
        const data = await requestJson('/return-resource', { playerId: currentPlayerId, playerName: currentPlayerName, resource })
        if (data) {
          state = data.state
        }
      })
    }

    async function handleTakeDevelopmentCard() {
      await runAction(async () => {
        const data = await requestJson('/take-development-card', { playerId: currentPlayerId, playerName: currentPlayerName })
        if (data) {
          state = data.state
        }
      })
    }

    async function handlePlayDevelopmentCard(cardKey) {
      await runAction(async () => {
        const data = await requestJson('/play-development-card', {
          playerId: currentPlayerId,
          playerName: currentPlayerName,
          cardKey
        })
        if (data) {
          state = data.state
        }
      })
    }

    async function handleTakeLongestRoad() {
      await runAction(async () => {
        const data = await requestJson('/take-longest-road', { playerId: currentPlayerId, playerName: currentPlayerName })
        if (data) {
          state = data.state
        }
      })
    }

    async function handleTakeLargestArmy() {
      await runAction(async () => {
        const data = await requestJson('/take-largest-army', { playerId: currentPlayerId, playerName: currentPlayerName })
        if (data) {
          state = data.state
        }
      })
    }

    async function handleSetGamePhase(phase) {
      await runAction(async () => {
        const data = await requestJson('/set-game-phase', {
          playerId: currentPlayerId,
          playerName: currentPlayerName,
          phase
        })
        if (data) {
          state = data.state
          selectedPlacementPiece = null
        }
      })
    }

    async function handleDeclareWinner() {
      await runAction(async () => {
        const data = await requestJson('/declare-winner', {
          playerId: currentPlayerId,
          playerName: currentPlayerName
        })
        if (data) {
          state = data.state
          selectedPlacementPiece = null
        }
      })
    }

    rollButton.addEventListener('click', async () => {
      if (!currentPlayerId) {
        return
      }

      await runAction(async () => {
        const data = await requestJson('/roll-dice', { playerId: currentPlayerId, playerName: currentPlayerName })
        if (data) {
          state = data.state
        }
      })
    })

    randomTileButton.addEventListener('click', async () => {
      if (!currentPlayerId) {
        return
      }

      await runAction(async () => {
        const data = await requestJson('/random-tile', { playerId: currentPlayerId, playerName: currentPlayerName })
        if (data) {
          state = data.state
        }
      })
    })

    randomPipButton.addEventListener('click', async () => {
      if (!currentPlayerId) {
        return
      }

      await runAction(async () => {
        const data = await requestJson('/random-pips', { playerId: currentPlayerId, playerName: currentPlayerName })
        if (data) {
          state = data.state
        }
      })
    })

    phaseBar.addEventListener('click', async (event) => {
      const target = event.target.closest('.phase-chip')
      if (!target || !currentPlayerId) {
        return
      }

      const nextPhase = target.dataset.phase
      if (!nextPhase || nextPhase === state.gamePhase) {
        return
      }

      await handleSetGamePhase(nextPhase)
    })

    winButton.addEventListener('click', async () => {
      if (!currentPlayerId) {
        return
      }

      await handleDeclareWinner()
    })

    longestRoadButton.addEventListener('click', async () => {
      if (!currentPlayerId) {
        return
      }

      await handleTakeLongestRoad()
    })

    largestArmyButton.addEventListener('click', async () => {
      if (!currentPlayerId) {
        return
      }

      await handleTakeLargestArmy()
    })

    undoButton.addEventListener('click', async () => {
      if (!currentPlayerId) {
        return
      }

      await runAction(async () => {
        const data = await requestJson('/undo', { playerId: currentPlayerId, playerName: currentPlayerName })
        if (data) {
          state = data.state
        }
      })
    })

    flipButton.addEventListener('click', async () => {
      const confirmed = window.confirm('Flip the board and reset the game for everyone?')
      if (!confirmed) {
        return
      }

      await runAction(async () => {
        const data = await requestJson('/reset-game', {
          playerId: currentPlayerId,
          playerName: currentPlayerName
        })
        if (data) {
          clearPlayerIdentity()
          state = data.state
        }
      })
    })

    const eventSource = new EventSource('/events')
    eventSource.addEventListener('state', (event) => {
      const incoming = JSON.parse(event.data)
      if (incoming.reset) {
        clearPlayerIdentity()
      }
      state = incoming
      render()
    })

    window.addEventListener('load', async () => {
      const savedPlayer = loadPlayerIdentity()
      await ensurePlayerSession(savedPlayer)
    })

    window.addEventListener('resize', () => {
      render()
    })

    render()
  </script>
</body>
</html>
